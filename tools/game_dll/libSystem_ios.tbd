--- !tapi-tbd
# gtav - link stub for gtav_game.dylib (names only): the C library functions the freestanding game
# code calls, bound at load time to the system's /usr/lib/libSystem.B.dylib. Lets the bundled
# ld64.lld link without the iOS SDK (iOS app).
tbd-version:     4
targets:         [ arm64-ios ]
install-name:    '/usr/lib/libSystem.B.dylib'
current-version: 1351
exports:
  - targets:     [ arm64-ios ]
    symbols:     [ _log2f, _memcmp, _memcpy, _memmove, _memset, dyld_stub_binder ]
...
