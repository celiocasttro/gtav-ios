--- a/libavcodec/wmaprodec.c
+++ b/libavcodec/wmaprodec.c
@@ -2025,6 +2025,33 @@ static av_cold int xmaframes_decode_init(AVCodecContext* avctx)
     return decode_init(s, avctx, 0);
