+/**
+ *@brief Start a new stream: what a freshly opened context has (the previous stream's MDCT
+ *       overlap tail, window shape and bit reservoir go), without rebuilding the MDCT, sine
+ *       window and VLC tables as a reopen does (gtav: the game starts a stream per sound, and
+ *       reopening for each was ~20% of the audio thread on a phone).
+ */
+static void xmaframes_flush(AVCodecContext *avctx)
+{
+    WMAProDecodeCtx *s = avctx->priv_data;
+    const size_t packet_state = offsetof(WMAProDecodeCtx, pgb);
+    const size_t keep_from = offsetof(WMAProDecodeCtx, nb_channels);
+    const size_t zero_from = offsetof(WMAProDecodeCtx, channels_for_cur_subframe);
+    const size_t channels = offsetof(WMAProDecodeCtx, channel);
+    int i;
+
+    /** everything decoding changes is zero in a new context (priv_data is zeroed) except what
+        decode_init sets: nb_channels, packet_loss, skip_frame (0) and prev_block_len. A partial
+        reset (wmapro's flush: half the output buffer) left louder pops between sounds. */
+    memset((uint8_t *)s + packet_state, 0, keep_from - packet_state);
+    memset((uint8_t *)s + zero_from, 0, channels - zero_from);
+    for (i = 0; i < s->nb_channels; i++) {
+        memset(&s->channel[i], 0, sizeof(s->channel[i]));
+        s->channel[i].prev_block_len = s->samples_per_frame;
+    }
+    s->packet_loss = 1;
+}
+
 static av_cold int xmaframes_decode_end(AVCodecContext* avctx)
 {
     WMAProDecodeCtx *s = avctx->priv_data;
@@ -2152,6 +2179,7 @@ AVCodec ff_xmaframes_decoder = {
     .init           = xmaframes_decode_init,
     .close          = xmaframes_decode_end,
     .decode         = xmaframes_decode_packet,
+    .flush          = xmaframes_flush,
     .capabilities   = AV_CODEC_CAP_DR1,
     .caps_internal  = FF_CODEC_CAP_INIT_CLEANUP,
     .sample_fmts    = (const enum AVSampleFormat[]) { AV_SAMPLE_FMT_FLTP,
