+static void ChainToPrevious(int sig, siginfo_t* info, void* ucontext) {
+  const struct sigaction& prev = g_previous[sig];
+  if (prev.sa_flags & SA_SIGINFO) {
+    if (prev.sa_sigaction) {
+      prev.sa_sigaction(sig, info, ucontext);
