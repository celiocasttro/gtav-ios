+    const size_t want = size_t(std::max(REXCVAR_GET(xma_fresh_contexts), 0));
+    if (failed_) return nullptr;
+    for (auto& [format, pool] : pools_)
+      if (pool.size() < want) return &format;
+    return nullptr;
+  }
