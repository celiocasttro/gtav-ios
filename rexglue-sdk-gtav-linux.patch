+bool AndroidNativeWindowSurface::GetSizeImpl(uint32_t& width_out, uint32_t& height_out) const {
+  int width = ANativeWindow_getWidth(window_);
+  int height = ANativeWindow_getHeight(window_);
+  if (width <= 0 || height <= 0) {
+    return false;
