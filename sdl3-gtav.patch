diff --git a/src/core/android/SDL_android.c b/src/core/android/SDL_android.c
index fa55948..380f65b 100644
--- a/src/core/android/SDL_android.c
+++ b/src/core/android/SDL_android.c
@@ -1315,6 +1315,8 @@ retry:
         if (data->native_window) {
             ANativeWindow_release(data->native_window);
             data->native_window = NULL;
+            // gtav: Vulkan renderers poll this to notice the surface is gone (it kept the old one).
+            SDL_SetPointerProperty(SDL_GetWindowProperties(Android_Window), SDL_PROP_WINDOW_ANDROID_WINDOW_POINTER, NULL);
         }
 
         // GL Context handling is done in the event loop because this function is run from the Java thread
diff --git a/src/events/SDL_events.c b/src/events/SDL_events.c
index c909a2a..e7b2bc6 100644
--- a/src/events/SDL_events.c
+++ b/src/events/SDL_events.c
@@ -1149,6 +1149,7 @@ static int SDL_PeepEventsInternal(SDL_Event *events, int numevents, SDL_EventAct
                                   Uint32 minType, Uint32 maxType, bool include_sentinel)
 {
     int i, used, sentinels_expected = 0;
+    bool wake = false;
 
     // Lock the event queue
     used = 0;
@@ -1172,6 +1173,11 @@ static int SDL_PeepEventsInternal(SDL_Event *events, int numevents, SDL_EventAct
             }
             for (i = 0; i < numevents; ++i) {
                 used += SDL_AddEvent(&events[i]);
+                // The poll sentinel is added by every pump: waking the waiter for it made the
+                // Android event wait spin (pump -> sentinel -> wake -> pump).
+                if (events[i].type != SDL_EVENT_POLL_SENTINEL) {
+                    wake = true;
+                }
             }
         } else {
             SDL_EventEntry *entry, *next;
@@ -1209,7 +1215,7 @@ static int SDL_PeepEventsInternal(SDL_Event *events, int numevents, SDL_EventAct
     }
     SDL_UnlockMutex(SDL_EventQ.lock);
 
-    if (used > 0 && action == SDL_ADDEVENT) {
+    if (used > 0 && action == SDL_ADDEVENT && wake) {
         SDL_SendWakeupEvent();
     }
 
